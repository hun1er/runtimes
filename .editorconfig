# Top-most EditorConfig file
root = true

# =================================================
#   All Files
# =================================================

[*]
charset = utf-8
end_of_line = lf
guidelines = 120
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# HCL
[*.hcl]
indent_size = 2

# Markdown
[*.{md,mdx}]
indent_size = 2
trim_trailing_whitespace = false

# YAML/YML
[*.{yaml,yml}]
indent_size = 2
